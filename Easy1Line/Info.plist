<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Easy1Line uses your local network to sync drawings with nearby devices over Wi-Fi.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Easy1Line uses Bluetooth to sync drawings with nearby devices when Wi-Fi isn't available.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_e1l-schematic._tcp</string>
		<string>_e1l-schematic._udp</string>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.mazzwebdesign.easy1line.line</string>
			<key>UTTypeDescription</key>
			<string>Easy1Line Schematic</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>line</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
